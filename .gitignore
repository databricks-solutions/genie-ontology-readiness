# Org secret-guard (from databricks-solutions seed): ignore *conf*.json to keep
# credential/config files out — but NOT the TypeScript project files it also matches.
*conf*.json
!tsconfig.json
!tsconfig.*.json
!release-please-config.json
.idea/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node / frontend build
node_modules/
app/frontend/dist/
*.tsbuildinfo
# Rendered app config (generated by post_deploy.py)
app/app.yml
# DABs
.databricks/
# Local env
.env
*.local
# Local-only screenshots (not checked in)
docs/screenshots/
# Screen-recording sources (only the generated GIFs are committed)
*.mov
.DS_Store
