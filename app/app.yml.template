# Template for app.yml — DO NOT edit app.yml by hand.
# scripts/post_deploy.py generates app/app.yml with workspace-specific values.
# If deploying manually, copy this to app/app.yml and fill in the values.
command:
  - python
  - app.py
env:
  - name: DATABRICKS_WAREHOUSE_ID
    valueFrom: sql-warehouse
  # Optional: restrict the assessment to specific catalogs (comma-separated).
  - name: ASSESS_CATALOGS
    value: ""
  # Largest request body the app will accept, in bytes (default 2 MiB).
  - name: MAX_REQUEST_BYTES
    value: "2097152"
  # Postgres TLS mode for the history database. "verify-full" (default) checks the
  # certificate and hostname; lower it only if your endpoint presents a certificate
  # outside the container's CA bundle.
  - name: LAKEBASE_SSL_MODE
    value: "verify-full"
  # Optional: enable the live Genie answer-quality test (pillar 5).
  # A Genie answer returns rows from your warehouse. The test runs on-behalf-of
  # the viewer where the workspace allows it; see GENIE_ALLOW_SP_FALLBACK below.
  - name: GENIE_SPACE_ID
    value: ""
  # The deployed workspace's id — seeds the default workspace-filter selection so
  # the activity signals (Genie/Adoption/lineage) scope to this workspace by
  # default on a shared metastore. post_deploy.py resolves it automatically.
  - name: WORKSPACE_ID
    value: ""
  # Product-telemetry version tag, attached to the User-Agent of every Databricks
  # API call so logfood can attribute usage by version. Baked from `git describe`
  # by post_deploy.py because the deployed app has no .git. See
  # app/server/_telemetry.py.
  - name: GOR_VERSION
    value: ""
  # The Genie test runs on-behalf-of the viewer whenever a viewer token is
  # forwarded. This controls what happens when there is no viewer token, which is
  # the normal case unless user authorization is enabled for the app.
  # "false" (default) = decline with a 403 instead of answering, so a viewer can
  #   never read (via the app service principal) rows from tables they lack grants
  #   on — this is the fail-closed default that closes the reported authorization
  #   bypass (CWE-269/863).
  # "true" = answer as the app service principal, as before, for a deployment that
  #   explicitly accepts the risk (logs a warning on every such call).
  # Either way the identity that answered is logged and returned as `ran_as`.
  - name: GENIE_ALLOW_SP_FALLBACK
    value: "false"
  # Branding shown in the app header.
  - name: BRAND_NAME
    value: "Databricks"
  # Identity override: "true" forces EVERY read to run as the app service
  # principal (OBO is never attempted), even when user authorization is enabled.
  # Default "false" = OBO-first with automatic SP fallback. Set "true" to
  # guarantee consistent workspace-wide system-table signals regardless of the
  # viewer's own grants (the SP must then hold the read grants below).
  - name: FORCE_SP
    value: "false"
  # Per-user assessment/plan history persistence (Lakebase). post_deploy.py sets
  # these: it creates the database on the shared instance, attaches the
  # 'lakebase-db' app resource, and pins the host/user/database/instance below. The app
  # authenticates to Postgres with an instance-scoped database credential minted from
  # the Databricks database credentials API.
  - name: USE_LAKEBASE
    value: "false"
  - name: LAKEBASE_HOST
    value: ""
  - name: LAKEBASE_USER
    value: ""
  - name: LAKEBASE_DATABASE
    value: "ontology_readiness"
  # Lakebase Autoscaling endpoint resource name. Leave empty for Provisioned.
  - name: LAKEBASE_ENDPOINT_NAME
    value: ""
  - name: LAKEBASE_INSTANCE_NAME
    value: ""
