; Pin the public npm registry. Without this, regenerating package-lock.json on a
; machine configured to use Databricks' internal npm proxy leaks internal
; `npm-proxy.cloud.databricks.com` URLs into the committed lockfile, which breaks
; `npm ci` for anyone cloning this public repo (and on Databricks serverless, whose
; proxy mirror is incomplete). Keeping the registry pinned here means any
; regeneration — local, dependabot, or CI — writes public registry.npmjs.org URLs.
registry=https://registry.npmjs.org/
